<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>FragmentsUnity.UnityLayer</AssemblyName>
    <RootNamespace>FragmentsUnity</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageRoot>$(MSBuildThisFileDirectory)..\..\..</PackageRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="UnityStubs.cs" />
    <Compile Include="UnityEditorStubs.cs" />
    <Compile Include="$(PackageRoot)\Runtime\Unity\**\*.cs" />
    <Compile Include="$(PackageRoot)\Editor\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\FragmentsUnity.Core.csproj" />
  </ItemGroup>
</Project>
